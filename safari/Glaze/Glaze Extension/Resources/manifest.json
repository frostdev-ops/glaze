{
  "manifest_version": 3,
  "name": "Glaze",
  "short_name": "Glaze",
  "version": "3.4.6",
  "description": "Restyle Blackboard Ultra, Canvas and Moodle: palettes, fonts, backgrounds and motion, plus handy extras.",
  "default_locale": "en",
  "permissions": [
    "storage",
    "scripting",
    "unlimitedStorage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "minimum_chrome_version": "113",
  "browser_specific_settings": {
    "gecko": {
      "id": "glaze@frostdev.io",
      "strict_min_version": "140.0"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Glaze",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "lib/background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "options_ui": {
    "page": "options.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/ultra",
        "https://*/ultra/*"
      ],
      "js": [
        "lib/color.js",
        "lib/i18n.js",
        "lib/page.js",
        "lib/grades.js",
        "lib/fonts.js",
        "lib/surfaces.js",
        "defaults.js",
        "lib/nav.js",
        "content-ultra.js",
        "content.js"
      ],
      "exclude_matches": [
        "https://*.instructure.com/*"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.instructure.com/*"
      ],
      "js": [
        "lib/color.js",
        "lib/i18n.js",
        "lib/page.js",
        "lib/grades.js",
        "lib/fonts.js",
        "lib/surfaces.js",
        "defaults.js",
        "content-canvas.js",
        "content.js"
      ],
      "exclude_matches": [
        "https://canvadocs.instructure.com/*"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.moodlecloud.com/*"
      ],
      "js": [
        "lib/color.js",
        "lib/i18n.js",
        "lib/page.js",
        "lib/grades.js",
        "lib/fonts.js",
        "lib/surfaces.js",
        "defaults.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "exclude_matches": [
        "https://*/ultra",
        "https://*/ultra/*"
      ]
    },
    {
      "matches": [
        "https://*/*"
      ],
      "exclude_matches": [
        "https://*/ultra",
        "https://*/ultra/*",
        "https://*.instructure.com/*",
        "https://*.moodlecloud.com/*"
      ],
      "js": [
        "lib/detect.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://frostdev.io/glaze/looks",
        "https://frostdev.io/glaze/looks/*",
        "https://frostdev.io/glaze/mods",
        "https://frostdev.io/glaze/mods/*"
      ],
      "js": [
        "lib/gallery.js"
      ]
    },
    {
      "matches": [
        "https://*.instructure.com/*"
      ],
      "js": [
        "lib/ink.js",
        "lib/surfaces.js",
        "features/docviewer.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "theme.css",
        "motion.css",
        "extras.css",
        "canvas.css",
        "moodle.css",
        "fonts/*.woff2",
        "assets/art/pets/*/sprites.webp",
        "assets/art/pets/*/spritesheet.webp",
        "assets/art/pets/*/reactions.webp",
        "assets/art/stickers/*/*.webp",
        "assets/art/cursors/*/*.png",
        "assets/art/cursors/*/*.svg",
        "features/lookx.css",
        "features/rules.css",
        "features/navlayout.css",
        "features/navbar.css",
        "features/apps.css",
        "features/surfaces.css",
        "features/coursetabs.css",
        "features/sidebar.css",
        "features/docreview.css",
        "assets/logo.svg",
        "assets/logo-dark.svg",
        "icons/icon.svg"
      ],
      "matches": [
        "https://*/*"
      ]
    },
    {
      "resources": [
        "lib/scene.js",
        "lib/three.js",
        "lib/scene-media.js",
        "lib/lottie/lottie_light_canvas.js",
        "reader.html",
        "writer.html",
        "fonts/*.woff2"
      ],
      "matches": [
        "https://*/*"
      ]
    },
    {
      "resources": [
        "sharing/quick.html",
        "options.html",
        "preview.html",
        "features/allow.html"
      ],
      "matches": [
        "https://*/*"
      ]
    }
  ]
}

{
  "manifest_version": 3,
  "name": "Glaze for Blackboard Ultra",
  "version": "2.1.4",
  "description": "__MSG_description__",
  "default_locale": "en",
  "permissions": [
    "storage"
  ],
  "minimum_chrome_version": "121",
  "browser_specific_settings": {
    "gecko": {
      "id": "glaze@frostdev.io",
      "strict_min_version": "121.0"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Glaze",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "lib/background.js"
  },
  "options_ui": {
    "page": "options.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/ultra/*"
      ],
      "js": [
        "lib/color.js",
        "i18n/de.js",
        "i18n/es.js",
        "i18n/fr.js",
        "i18n/nl.js",
        "i18n/pt-BR.js",
        "lib/i18n.js",
        "lib/page.js",
        "lib/grades.js",
        "lib/fonts.js",
        "lib/drafts.js",
        "lib/zip.js",
        "defaults.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "theme.css",
        "motion.css",
        "extras.css",
        "fonts/*.woff2"
      ],
      "matches": [
        "https://*/*"
      ]
    },
    {
      "resources": [
        "lib/scene.js",
        "lib/three.min.js",
        "fonts/*.woff2"
      ],
      "matches": [
        "https://*/*"
      ]
    }
  ]
}

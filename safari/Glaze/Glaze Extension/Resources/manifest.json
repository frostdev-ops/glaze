{
  "manifest_version": 3,
  "name": "Glaze",
  "short_name": "Glaze",
  "version": "4.0.9",
  "description": "Restyle Blackboard Ultra, Canvas and Moodle: palettes, fonts, backgrounds and motion, plus handy extras.",
  "default_locale": "en",
  "permissions": [
    "storage",
    "scripting",
    "unlimitedStorage",
    "alarms",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "minimum_chrome_version": "113",
  "browser_specific_settings": {
    "gecko": {
      "id": "glaze@frostdev.io",
      "strict_min_version": "140.0"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Glaze",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "scripts": [
      "background/event-page.js",
      "courses/download.js",
      "courses/seen.js",
      "core/color.js",
      "looks/fonts.js",
      "looks/surfaces.js",
      "content/defaults.js",
      "looks/lookset.js",
      "looks/history.js",
      "courses/cards.js",
      "navigation/nav.js",
      "navigation/nav-items.js",
      "navigation/navlayout.js",
      "navigation/navbar.js",
      "looks/motionx.js",
      "looks/parts.js",
      "navigation/nav-store.js",
      "planner/todo.js",
      "pet/petbrain.js",
      "pet/pet.js",
      "pet/petsprites.js",
      "planner/remind.js",
      "core/widgets.js",
      "navigation/sidebar.js",
      "looks/lookparts.js",
      "sharing/share.js",
      "looks/lookx.js",
      "looks/looks.js",
      "planner/gradescope.js",
      "core/doctext.js",
      "courses/folders.js",
      "planner/notes.js",
      "planner/calexport.js",
      "planner/gcal.js",
      "planner/gcal-auth.js",
      "core/site.js",
      "navigation/coursetabs.js",
      "pearson/notation.js",
      "pearson/native.js",
      "background/pearson.js",
      "pearson/embed.js",
      "background/pearson-embed.js",
      "planner/gradecalc.js",
      "planner/gpa.js",
      "planner/insights.js",
      "planner/classes.js",
      "planner/syllabus.js",
      "writer/drafts.js",
      "documents/doc-files.js",
      "ai/memory.js",
      "background/backup.js",
      "core/zip.js",
      "mods/modapi.js",
      "mods/modwidget.js",
      "ai/schema.js",
      "mods/modtools.js",
      "mods/modbundle.js",
      "looks/media.js",
      "mods/modbroker.js",
      "sharing/relay.js",
      "sharing/sharing.js",
      "sharing/sessions.js",
      "core/i18n.js",
      "i18n/de.js",
      "i18n/es.js",
      "i18n/fr.js",
      "i18n/nl.js",
      "i18n/pt-BR.js",
      "writer/writer-sources.js",
      "writer/writer-lookup.js",
      "courses/bb-preview.js",
      "writer/writer-styles.js",
      "writer/writer-papers.js",
      "vendor/pm.js",
      "writer/writer-schema.js",
      "writer/writer-cite.js",
      "ai/request.js",
      "ai/stream.js",
      "ai/failure.js",
      "ai/endpoint.js",
      "ai/text.js",
      "ai/visual-cache.js",
      "ai/models.js",
      "ai/providers.js",
      "ai/providers/openai.js",
      "ai/providers/device.js",
      "ai/providers/apple.js",
      "ai/local/store.js",
      "ai/local/updates.js",
      "ai/local/format.js",
      "ai/local/link.js",
      "ai/local/ladder.js",
      "ai/providers/local.js",
      "ai/tools.js",
      "ai/loop.js",
      "ai/task.js",
      "ai/agent/memory.js",
      "ai/recall.js",
      "ai/tasks/syllabus-read.js",
      "ai/tasks/writer-context.js",
      "ai/tasks/writer-complete.js",
      "ai/tasks/writer-review.js",
      "ai/tasks/writer-image.js",
      "ai/tasks/writer-feedback.js",
      "ai/tasks/writer-outline.js",
      "ai/tasks/writer-requirements.js",
      "ai/tasks/writer-cite.js",
      "ai/tasks/writer-decide.js",
      "ai/tasks/wording.js",
      "ai/tasks/study-help.js",
      "ai/current.js",
      "ai/tasks/agent-tools.js",
      "ai/tasks/chat-compact.js",
      "ai/agent/js.js",
      "ai/agent/places.js",
      "ai/agent/wakes.js",
      "ai/agent/school.js",
      "ai/settings.js",
      "ai/broker.js",
      "ai/ask.js",
      "vendor/quickjs/quickjs.js",
      "ai/memory-manager.js",
      "agents/agent-frames.js",
      "agents/agent-link.js",
      "agents/grants.js",
      "agents/registry.js",
      "agents/tools-study.js",
      "agents/tools-grades.js",
      "documents/doc-home.js",
      "writer/writer-tools.js",
      "agents/writer.js",
      "agents/tabs.js",
      "agents/tools-assign.js",
      "agents/wire.js",
      "agents/approve.js",
      "agents/calls.js",
      "agents/modroute.js",
      "mods/blocklist.js",
      "mods/modchannel.js",
      "background/oauth.js",
      "background/google-config.js",
      "background/google.js",
      "documents/doc-kinds.js",
      "documents/drive.js",
      "documents/drive-sync.js",
      "background/drive-store.js",
      "writer/writer-color.js",
      "writer/writer-docx.js",
      "writer/writer-objects-docx.js",
      "writer/writer-format.js",
      "writer/writer-submit.js",
      "documents/sheets/sheet-model.js",
      "documents/sheets/sheet-numfmt.js",
      "documents/sheets/sheet-formula.js",
      "documents/sheets/sheet-xlsx.js",
      "documents/sheets/sheet-data.js",
      "background/background.js"
    ],
    "persistent": false
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "options_ui": {
    "page": "options.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/ultra",
        "https://*/ultra/*"
      ],
      "js": [
        "core/color.js",
        "core/i18n.js",
        "core/page.js",
        "planner/grades.js",
        "looks/fonts.js",
        "looks/surfaces.js",
        "content/defaults.js",
        "navigation/nav.js",
        "content/content-ultra.js",
        "content/content.js"
      ],
      "exclude_matches": [
        "https://*.instructure.com/*"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.instructure.com/*"
      ],
      "js": [
        "core/color.js",
        "core/i18n.js",
        "core/page.js",
        "planner/grades.js",
        "looks/fonts.js",
        "looks/surfaces.js",
        "content/defaults.js",
        "content/content-canvas.js",
        "content/content.js"
      ],
      "exclude_matches": [
        "https://canvadocs.instructure.com/*"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.moodlecloud.com/*"
      ],
      "js": [
        "core/color.js",
        "core/i18n.js",
        "core/page.js",
        "planner/grades.js",
        "looks/fonts.js",
        "looks/surfaces.js",
        "content/defaults.js",
        "content/content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "exclude_matches": [
        "https://*/ultra",
        "https://*/ultra/*"
      ]
    },
    {
      "matches": [
        "https://*/*"
      ],
      "exclude_matches": [
        "https://*/ultra",
        "https://*/ultra/*",
        "https://*.instructure.com/*",
        "https://*.moodlecloud.com/*"
      ],
      "js": [
        "content/detect.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://frostdev.io/glaze/looks",
        "https://frostdev.io/glaze/looks/*",
        "https://frostdev.io/glaze/mods",
        "https://frostdev.io/glaze/mods/*"
      ],
      "js": [
        "looks/gallery.js"
      ]
    },
    {
      "matches": [
        "https://*.instructure.com/*"
      ],
      "js": [
        "courses/ink.js",
        "looks/surfaces.js",
        "courses/page/docviewer.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/theme.css",
        "content/motion.css",
        "content/extras.css",
        "pearson/embed.css",
        "content/canvas.css",
        "content/moodle.css",
        "fonts/*.woff2",
        "assets/art/pets/*/sprites.webp",
        "assets/art/pets/*/spritesheet.webp",
        "assets/art/pets/*/reactions.webp",
        "assets/art/stickers/*/*.webp",
        "assets/art/cursors/*/*.png",
        "assets/art/cursors/*/*.svg",
        "looks/page/lookx.css",
        "looks/page/rules.css",
        "navigation/page/navlayout.css",
        "navigation/page/navbar.css",
        "core/page/apps.css",
        "looks/page/surfaces.css",
        "navigation/page/coursetabs.css",
        "navigation/page/sidebar.css",
        "courses/page/docreview.css",
        "assets/logo.svg",
        "assets/logo-dark.svg",
        "icons/icon.svg"
      ],
      "matches": [
        "https://*/*"
      ]
    },
    {
      "resources": [
        "pearson-math.html",
        "pearson/render.mjs",
        "vendor/mathlive/mathlive.mjs",
        "vendor/mathlive/fonts/*.woff2"
      ],
      "matches": [
        "https://tdx.acs.pearson.com/*"
      ]
    },
    {
      "resources": [
        "looks/scene.js",
        "vendor/three.js",
        "looks/scene-media.js",
        "vendor/lottie/lottie_light_canvas.js",
        "reader.html",
        "writer.html",
        "fonts/*.woff2"
      ],
      "matches": [
        "https://*/*"
      ]
    },
    {
      "resources": [
        "sharing/quick.html",
        "options.html",
        "papers.html",
        "preview.html",
        "courses/allow.html"
      ],
      "matches": [
        "https://*/*"
      ]
    },
    {
      "resources": [
        "documents/picked.html"
      ],
      "matches": [
        "https://frostdev.io/*",
        "https://frostdev-ops.github.io/*"
      ]
    }
  ]
}

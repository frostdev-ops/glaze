# Copy to ~/.config/glaze/stores.env and chmod 600. Never put real secrets in this file.
# Shell syntax is not evaluated. Environment variables override this file.

# Chrome: defaults already match Glaze; uses the existing gcloud login (no service-account key).
# Run gcloud auth login if doctor reports expired authentication.
CWS_PUBLISHER_ID=82318a69-812d-438a-842f-e87fcaec1bd6
CWS_EXTENSION_ID=jmmaeoajomodnbnlmdikjooalmcilooh
CWS_SERVICE_ACCOUNT=cws-publisher@frostdev-507119.iam.gserviceaccount.com

# Firefox: https://addons.mozilla.org/developers/addon/api/key/
AMO_JWT_ISSUER=
AMO_JWT_SECRET=
AMO_ADDON_ID=glaze@frostdev.io

# Apple: App Store Connect > Users and Access > Integrations > App Store Connect API.
# Use a team API key with Admin access if Xcode must create certificates/profiles.
# A quoted absolute path or a path relative to this config file works; ~/ expands.
ASC_KEY_PATH=
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_BUNDLE_ID=io.frostdev.Glaze
SAFARI_TEAM_ID=22AAZFMTV8

# Public release: gh auth login must grant push/release access to both repositories.
# Existing Sparkle 2.10.0 tools and the matching signing key in this Mac's login Keychain.
SPARKLE_BIN=
# Defaults to ~/Projects/frostdev.io. Must have frostdev-ops/frostdev.io as origin.
FROSTDEV_SITE_DIR=~/Projects/frostdev.io
# Use a saved notarization profile, or the ASC_KEY_* values above.
NOTARY_PROFILE=
# Optional when using an existing nondefault Sparkle Keychain account:
SAFARI_UPDATE_KEY_ACCOUNT=ed25519

{
  "manifest_version": 3,
  "name": "Glaze",
  "version": "2.2.0",
  "description": "__MSG_description__",
  "default_locale": "en",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://*/*"
  ],
  "minimum_chrome_version": "113",
  "browser_specific_settings": {
    "gecko": {
      "id": "glaze@frostdev.io",
      "strict_min_version": "121.0"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Glaze",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "lib/background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/ultra",
        "https://*/ultra/*",
        "https://*.instructure.com/*"
      ],
      "js": [
        "lib/color.js",
        "lib/i18n.js",
        "lib/page.js",
        "lib/grades.js",
        "lib/fonts.js",
        "defaults.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://*/*"
      ],
      "exclude_matches": [
        "https://*/ultra",
        "https://*/ultra/*",
        "https://*.instructure.com/*"
      ],
      "js": [
        "lib/detect.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://frostdev.io/glaze/looks",
        "https://frostdev.io/glaze/looks/*"
      ],
      "js": [
        "lib/gallery.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "theme.css",
        "motion.css",
        "extras.css",
        "canvas.css",
        "moodle.css",
        "fonts/*.woff2",
        "assets/art/pets/*/sprites.webp",
        "assets/art/stickers/critters/study-buddy.webp",
        "assets/art/stickers/critters/study-buddy-happy.webp",
        "assets/art/stickers/critters/study-buddy-sleepy.webp"
      ],
      "matches": [
        "https://*/*"
      ],
      "use_dynamic_url": true
    },
    {
      "resources": [
        "lib/scene.js",
        "lib/three.min.js",
        "fonts/*.woff2"
      ],
      "matches": [
        "https://*/*"
      ]
    }
  ]
}

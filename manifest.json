{
  "manifest_version": 3,
  "name": "Glaze for Blackboard Ultra",
  "version": "1.0.0",
  "description": "A customizable colour theme with motion and glass for Blackboard Ultra. Toggleable, every colour and animation yours to set.",
  "permissions": ["storage"],
  "minimum_chrome_version": "113",
  "browser_specific_settings": {
    "gecko": {
      "id": "glaze@frostdev.io",
      "strict_min_version": "121.0"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Glaze",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://*/ultra/*"],
      "js": ["defaults.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["theme.css"],
      "matches": ["https://*/*"],
      "use_dynamic_url": true
    }
  ]
}

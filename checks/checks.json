{
  "format": "checks/<path>: needs (tags below), limit (seconds, a first guess), args and env ({out} is the evidence folder), run (the script that runs it), partOf (a module another check runs), why, note",
  "tags": {
    "runner": "plain Chromium in the Linux runner's container (also runs on the Mac unless it also carries linux)",
    "mac": "only on the Mac: sandbox-exec, Safari, native Firefox, the local Canvas or Moodle",
    "linux": "uses Linux facilities (Xvfb, /proc): the runner only",
    "canvas": "the local Canvas at localhost:3000 (Colima on the Mac)",
    "moodle": "the local Moodle at localhost:8081 (Colima on the Mac)",
    "gpu": "a real GPU adapter",
    "network": "reaches the real internet",
    "headed": "a display: Xvfb on the runner",
    "safari": "drives the owner's Safari: only with the owner's OK",
    "inputs": "files or a revision that are not in the repo, given by hand",
    "unknown": "could not be told by reading: see why"
  },
